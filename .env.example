# Gemini / Gemma Cloud API (Optional — SentinelDesk gracefully degrades to Local ML + Ollama Gemma 4 if unset)
GEMINI_API_KEY=

# System 1 Calibrated Gatekeeper (Google GenAI v1beta Decisions API)
DECISION_MODEL=gemini-decision-1

# System 2 Cloud Drafter (PII-scrubbed payload only)
CLOUD_DRAFTER_MODEL=gemini-3.5-flash-lite

# System 2 Local Air-Gapped Drafter (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# Hybrid Triage Ensemble Blending Weights (Cloud Mode Only; Local Air-Gapped makes 0 cloud calls)
HYBRID_ML_WEIGHT=0.75
HYBRID_D1_WEIGHT=0.25
